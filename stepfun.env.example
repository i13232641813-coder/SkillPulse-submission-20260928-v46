# SkillPulse optional StepFun config (AI requirement parsing).
#
# 1. Copy this file to stepfun.env and fill in your key, then run run.cmd.
#    Get a key from https://platform.stepfun.com (China) or https://platform.stepfun.ai (Global).
# 2. If stepfun.env is absent, StepFun parsing is disabled; local search and security checks still work.
# 3. Never commit stepfun.env (it is git-ignored). The key is loaded only into this process.
#
STEPFUN_API_KEY=sk-your-key-here
# Region: china (default) or global. Keys are NOT interchangeable between regions.
STEPFUN_REGION=china
